# Agent Capital Tree — environment variables
# Copy to .env (or configure in the Vercel project settings) and fill in values.

# --- Web app (apps/web) ---------------------------------------------------

# Server-side Ethereum Sepolia RPC endpoint.
# REQUIRED for live dashboard reads; without it /api/tree and /api/activity
# return HTTP 503 "rpc_unconfigured". A public endpoint works for demos:
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Curvegrid MultiBaas — OPTIONAL. Only the activity feed depends on these;
# if unset, the rest of the dashboard still works.
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_CONTROLLER_LABEL=

# --- Agent runtime / plugin (packages/runtime, packages/plugin) -----------
# Not needed for the web deployment; used by the isolated agent workers.
ACT_RUNTIME_URL=
ACT_MCP_TOKEN=
