{
  "name": "@agent-capital-tree/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-capital.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:chain": "pnpm build && node test/chain.integration.mjs",
    "test:workers": "node test/worker.integration.mjs && node test/model.integration.mjs"
  },
  "dependencies": {
    "@agent-capital-tree/multibaas": "workspace:*",
    "@agent-capital-tree/plugin": "workspace:*",
    "@agent-capital-tree/sdk": "workspace:*",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "ethers": "6.17.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
