FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN mkdir -p /opt/act /run/worker /home/worker && chmod 755 /run/worker /home/worker
COPY codex /opt/act/codex
COPY plugin-server.mjs /opt/act/plugin-server.mjs
COPY bridge.mjs /opt/act/bridge.mjs
RUN chmod 0555 /opt/act/codex && chmod 0444 /opt/act/plugin-server.mjs /opt/act/bridge.mjs
WORKDIR /workspace
